    "mac": { "icon": "build/icon.png", "identity": "-", "hardenedRuntime": false }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.323",
    "@base-ui/react": "^1.9.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@pierre/diffs": "^1.6.4",
    "@shadcn/react": "^0.3.1",
    "bot-avatars": "file:../bots",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module"
