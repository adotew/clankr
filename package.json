{
  "name": "clankr",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "app": "electron-vite build && electron-builder --mac dir"
  },
  "build": {
    "appId": "com.clankr.app",
